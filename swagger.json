{
  "openapi": "3.0.3",
  "info": {
    "title": "Source Engine Server List API",
    "description": "Counter-Strike: Source discovery, live snapshots, durable abuse enforcement, evidence, and recovery.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8888",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/servers": {
      "get": {
        "summary": "List eligible online servers",
        "responses": {
          "200": {
            "description": "Fresh eligible server snapshots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OnlineServer"
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/MembershipUnavailable"
          }
        }
      }
    },
    "/server/{address}": {
      "get": {
        "summary": "Get a fresh eligible player roster",
        "parameters": [
          {
            "$ref": "#/components/parameters/ServerAddress"
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh player roster",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Player"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/MembershipUnavailable"
          }
        }
      }
    },
    "/blacklist": {
      "get": {
        "summary": "Get the Counter-Strike: Source blacklist",
        "description": "Whole-IP entries use port zero. Active per-server durable bans use their nonzero server port. Invalid legacy addresses are omitted.",
        "responses": {
          "200": {
            "description": "Valve KeyValues blacklist",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/admin/add": {
      "post": {
        "summary": "Add or retain a server",
        "description": "The same UUID and address replay the stored result, including the originally resolved country. Reusing the UUID for a different intent returns 409.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ServerAddressForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MutationResult"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/MembershipUnavailable"
          }
        }
      }
    },
    "/admin/blacklist": {
      "post": {
        "summary": "Immediately ban one server",
        "description": "Creates durable manual authority. A same-key retry returns the stored result. Historical-only reasons are readable but cannot be written.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "example": "54.37.245.51:27045"
                  },
                  "reason": {
                    "$ref": "#/components/schemas/WritableServerBanReason"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MutationResult"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "description": "The IP is whitelisted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/MembershipUnavailable"
          }
        }
      }
    },
    "/admin/unban": {
      "post": {
        "summary": "Recover one durable server ban",
        "description": "Clears active strike state and compatibility state while preserving evidence and enforcement history. If the server row no longer exists, requires_repopulation is true.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ServerAddressForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/RecoveryResult"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/MembershipUnavailable"
          }
        }
      }
    },
    "/admin/unblacklist": {
      "post": {
        "summary": "Recover one exact whole-IP blacklist",
        "description": "Targets the blacklist row captured by the operation receipt. Linked enforcement contributors determine which tracker bans and states are cleared. Manual and legacy server bans remain active. Deleted server rows require a complete fetch or manual add to repopulate.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "format": "ipv4",
                    "example": "54.37.245.51"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/RecoveryResult"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/MembershipUnavailable"
          }
        }
      }
    },
    "/admin/banned": {
      "get": {
        "summary": "List active durable server bans",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Manual, tracker-confirmed, and legacy bans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BannedServer"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/admin/observations": {
      "get": {
        "summary": "List bounded abuse evidence",
        "description": "Ordered by observed_at DESC, id DESC. Pass next_cursor unchanged to fetch the next page.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "ip",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ipv4"
            }
          },
          {
            "name": "address",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reason",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/DetectionReason"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observation page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/admin/audit": {
      "get": {
        "summary": "Summarize legacy enforcement",
        "description": "Groups legacy server bans and event-unlinked legacy blacklists by their persisted reason.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Legacy enforcement counts"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "Get this OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI JSON"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "A canonical lowercase UUID retained for this user intent and reused for transport or unknown-outcome retries.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ServerAddress": {
        "name": "address",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "example": "54.37.245.51:27045"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed address, filter, reason, limit, cursor, or idempotency key"
      },
      "Conflict": {
        "description": "The idempotency key belongs to another intent, or current durable policy rejects the request"
      },
      "NotFound": {
        "description": "The requested server or eligible roster does not exist"
      },
      "InternalError": {
        "description": "Database or internal failure"
      },
      "MembershipUnavailable": {
        "description": "Tracker membership is unavailable, or an indeterminate mutation returns its operation key, retry_same_key=true, and unknown_membership_converged or unknown_membership_degraded"
      },
      "MutationResult": {
        "description": "Durable mutation result with attempt-local publication_status. A known commit remains successful when publication_status is committed_membership_degraded. A same-key retry returns the same operation identity and domain result."
      },
      "RecoveryResult": {
        "description": "Durable recovery result with outcome, operation ID, replay status, event IDs, requires_repopulation, and attempt-local publication_status."
      }
    },
    "schemas": {
      "ServerAddressForm": {
        "type": "object",
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string",
            "example": "54.37.245.51:27045"
          }
        }
      },
      "DetectionReason": {
        "type": "string",
        "enum": [
          "illegal_player_count",
          "non_css_application",
          "player_count_mismatch",
          "same_connection_time",
          "duplicate_roster",
          "steam_metadata_illegal_counts",
          "steam_metadata_duplicate_signature"
        ]
      },
      "WritableServerBanReason": {
        "type": "string",
        "default": "none",
        "enum": [
          "none",
          "illegal_player_count",
          "non_css_application",
          "player_count_mismatch",
          "same_connection_time",
          "duplicate_roster"
        ]
      },
      "OnlineServer": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "map": {
            "type": "string"
          },
          "players": {
            "type": "integer"
          },
          "max_players": {
            "type": "integer"
          },
          "bots": {
            "type": "integer"
          },
          "ip": {
            "type": "string",
            "format": "ipv4"
          },
          "port": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        }
      },
      "Player": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          },
          "connection_time": {
            "type": "number"
          }
        }
      },
      "BannedServer": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "banned_at": {
            "type": "string",
            "format": "date-time"
          },
          "abuse_reason": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "tracker",
              "legacy"
            ]
          },
          "strike_count": {
            "type": "integer"
          },
          "last_detected_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid": {
            "type": "boolean"
          },
          "validity_reason": {
            "type": "string"
          }
        }
      },
      "ObservationPage": {
        "type": "object",
        "properties": {
          "next_cursor": {
            "type": "string"
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            }
          }
        }
      },
      "Observation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "cycle_id": {
            "type": "integer"
          },
          "address": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/DetectionReason"
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "detector_version": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
